# OpenAI-compatible Chat Completions endpoint; never commit a real API key.
AGENTCOMPILER_LLM_API_KEY=
AGENTCOMPILER_LLM_MODEL=gpt-4o-mini
# AGENTCOMPILER_LLM_BASE_URL=https://openrouter.ai/api/v1
# AGENTCOMPILER_SPECIALIST_MODEL=
AGENTCOMPILER_STRUCTURED_MODE=json_object
AGENTCOMPILER_LLM_MAX_TOKENS=4096
AGENTCOMPILER_MAX_CONCURRENCY=4
AGENTCOMPILER_MAX_TASKS=128
AGENTCOMPILER_MAX_ROUNDS=3
AGENTCOMPILER_MAX_PLAN_ATTEMPTS=3
AGENTCOMPILER_MAX_TASK_ATTEMPTS=2
AGENTCOMPILER_MAX_TOOL_CALLS=12
AGENTCOMPILER_MAX_LLM_CALLS=100
AGENTCOMPILER_RUN_TIMEOUT_SECONDS=300
AGENTCOMPILER_TASK_TIMEOUT_SECONDS=60
AGENTCOMPILER_LLM_TIMEOUT_SECONDS=60
AGENTCOMPILER_RETRY_BACKOFF_SECONDS=0.5
AGENTCOMPILER_OPTIMIZE=true
AGENTCOMPILER_SCHEDULING=fifo
# Optional user-supplied price estimates, in currency units per million tokens.
AGENTCOMPILER_INPUT_COST_PER_MILLION=0
AGENTCOMPILER_OUTPUT_COST_PER_MILLION=0
